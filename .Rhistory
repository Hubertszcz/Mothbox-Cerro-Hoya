# #region agent log
debug_log_path <- "debug-e07b3f.log"
debug_ingest <- function(msg, data, hyp) {
vals <- vapply(data, function(x) if (is.character(x)) paste0('"', gsub('"', '\\\\"', x), '"') else as.character(x), character(1))
data_json <- paste0("{", paste0('"', names(data), '":', vals, collapse = ","), "}")
line <- paste0('{"sessionId":"e07b3f","hypothesisId":"', hyp, '","location":"0-data_cleanup.R","message":"', msg, '","data":', data_json, ',"timestamp":', round(as.numeric(Sys.time()) * 1000), "}")
write(line, file = debug_log_path, append = TRUE)
}
files_list <- list.files("data_raw/occurence_data", pattern = "\\.csv$", full.names = TRUE)
# #endregion
data_raw <- vroom(files_list, id = "source_file")
# #region agent log
debug_ingest("genus column type and NA count", list(
genus_class = paste(class(data_raw$genus), collapse = ","),
genus_na_count = sum(is.na(data_raw$genus)),
nrow = nrow(data_raw),
ncol = ncol(data_raw)
), "A")
diabrotica_rows <- data_raw[grepl("Diabrotica", data_raw$name, fixed = TRUE), ]
debug_ingest("genus for Diabrotica name rows", list(
n_diabrotica = nrow(diabrotica_rows),
genus_val_1 = if (nrow(diabrotica_rows) > 0) as.character(diabrotica_rows$genus[1]) else "none",
genus_val_2 = if (nrow(diabrotica_rows) > 1) as.character(diabrotica_rows$genus[2]) else "none"
), "A")
debug_ingest("first file in list (type guessing source)", list(
first_file = basename(files_list[1])
), "D")
unique_genus_20 <- head(unique(na.omit(as.character(data_raw$genus))), 20)
debug_ingest("unique genus sample", list(
n_unique_genus = length(unique(na.omit(as.character(data_raw$genus)))),
first_3 = paste(unique_genus_20[1:3], collapse = ";")
), "A")
# #endregion
metadata <- read.csv("data_raw/mothbox_metadata.csv")
View(diabrotica_rows)
