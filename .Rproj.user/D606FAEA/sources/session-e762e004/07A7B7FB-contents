#34075 inverts total across all samples. Less than half of what I had in my BCI study =)


#get rid of NAs because some of the metadata was missing, number of rows/columns shouldn't change if all is well
invert_data <- na.omit(invert_data)

#create order of land uses
land_use_vec <- c("pasture", "teak", "reforestation", "nat_regen", "mature")


invert_summary <- invert_data %>%
  filter(land_use %in% c("pasture", "teak", "reforestation", "nat_regen", "mature")) %>%
  group_by(land_use) %>%
  summarise(
    mean_invert_richness = mean(invert_richness, na.rm = TRUE),
    sd_invert_richness = sd(invert_richness, na.rm = TRUE),
    mean_invert_abundance = mean(invert_abundance, na.rm = TRUE),
    sd_invert_abundance = sd(invert_abundance, na.rm = TRUE),
    mean_invert_shannon = mean(invert_shannon, na.rm = TRUE),
    sd_invert_shannon = sd(invert_shannon, na.rm = TRUE),
    mean_invert_simpson = mean(invert_simpson, na.rm = TRUE),
    sd_invert_simpson = sd(invert_simpson, na.rm = TRUE),
    mean_invert_J = mean(invert_J, na.rm = TRUE),
    sd_invert_J = sd(invert_J, na.rm = TRUE)
  ) %>%
  arrange(factor(land_use, levels = land_use_vec)) # keep wanted order of land uses

invert_summary <- invert_summary %>%
    mutate(land_use = factor(land_use, levels = land_use_vec))

