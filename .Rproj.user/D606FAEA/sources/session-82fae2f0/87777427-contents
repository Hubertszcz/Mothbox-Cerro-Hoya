#load packages
library(ggplot2)
library(dplyr)
library(viridis)


#####################################################################
################# Land use and forest type ##########################
#####################################################################

#Read data
mothbox_data <- read.csv('C:/Users/Hubert/Desktop/Biodiversity Monitoring/Biodiversity data analysis/data input/mothbox/mothbox_summary.csv')

setwd("C:/Users/Hubert/Desktop//Biodiversity Monitoring/Biodiversity data analysis/data output")

# =========================================================
# Figure 1: Detections and land use
# =========================================================
mothbox_data$land_use <- factor(
  mothbox_data$land_use,
  levels = c("teak", "reforestation", "mature"))


p1 <- ggplot(mothbox_data, aes(x=land_use, y=mean_insect_activity, fill = land_use)) + 
  geom_col(stat = "identity") +
  scale_fill_viridis(discrete = TRUE, option = "viridis",direction = -1) +
  labs(x = "Land use", y = "Total detections") +
  theme_minimal(base_family = "Arial", base_size = 18) +
  theme(
    axis.title   = element_text(size = 38),
    axis.text    = element_text(size = 28),
    legend.position = "none"   # optional: remove legend (redundant with x-axis)
  )

png("Detections and land use.png",
    width = 12, height = 7.5, units = "in", res = 300, bg = "white")
print(p1)
dev.off()

