#####################################################################
####################### Time of night ###############################
#####################################################################
#Read data
dataA <- read.csv("C:/Users/Hubert/Desktop/Biodiversity Monitoring/Biodiversity data analysis/data input/mothbox/dataA.csv")
activity_data <- read.csv("C:/Users/Hubert/Desktop/Biodiversity Monitoring/Biodiversity data analysis/data input/mothbox/activity_data.csv")

setwd("C:/Users/Hubert/Desktop//Biodiversity Monitoring/Biodiversity data analysis/data output")


# =========================================================
# Figure 3: Richness per photo
# =========================================================
# ---- Order legend chronologically (across night) ----
hrs <- unique(dataA$hour)
hnum <- as.numeric(sub(":.*", "", hrs))
hour_levels <- hrs[order((hnum - 18) %% 24)]   # starts at 18:00 / evening
dataA$hour <- factor(dataA$hour, levels = hour_levels)

# Order the hour labels chronologically across midnight for activity_data
start_at <- 19

levels_order <- activity_data %>%
  distinct(hour) %>%
  mutate(start_hour = as.numeric(sub("^\\s*(\\d{1,2}).*$", "\\1", hour))) %>%
  arrange((start_hour - start_at) %% 24) %>%
  pull(hour)

activity_data$hour <- factor(activity_data$hour, levels = levels_order)


plot_data_richness <- dataA %>%
  group_by(hour, minute) %>%
  summarise(cumulativeRichness_hour = mean(cumulativeRichness_hour, na.rm = TRUE))

p3 <- ggplot(plot_data_richness, aes(x = minute, y = cumulativeRichness_hour, color = hour, group = hour)) +
  geom_line(size = 2.2, lineend = "round") +
  labs(x = "Minute", y = "Richness per photo", title = "", color = "Session") +
  scale_x_continuous(breaks = seq(0, 60, by = 10)) +
  scale_color_viridis(discrete = TRUE, option = "viridis") +
    theme_minimal(base_family = "Arial", base_size = 18) +
  theme(
    axis.title   = element_text(size = 30),
    axis.text    = element_text(size = 22),
    legend.title = element_text(size = 26),
    legend.text  = element_text(size = 22),
    legend.position = c(0.12, .8)
  )

png("Cumulative richness.png",
    width = 12, height = 7.5, units = "in", res = 300, bg = "white")
print(p3)
dev.off()

