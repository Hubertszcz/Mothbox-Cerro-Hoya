# =========================================================
# Figure 5: Average detections per hour
# =========================================================

p5 <- ggplot(activity_data, aes(x = hour, y = avg_activity, fill = hour)) +
  geom_col() +
  geom_errorbar(
    aes(
      ymin = avg_activity - se_activity,
      ymax = avg_activity + se_activity),
    width = 0.1,           # width of the little horizontal bar at top
    linewidth = 0.6  ) +      # optional: slightly thinner line
  scale_fill_viridis(discrete = TRUE, option = "viridis") +
  scale_x_discrete(labels = function(x) {
    ifelse(seq_along(x) %% 2 == 0, paste0("\n\n", x), x)  # stagger labels
  }) +
  labs(title = "", x = "Session", y = "Mean total detections") +
  theme_minimal(base_family = "Arial", base_size = 18) +
  theme(
    axis.title   = element_text(size = 30),
    axis.text    = element_text(size = 22),
    legend.position = "none"   # optional: remove legend (redundant with x-axis)
  )

png("Detections per hour.png",
    width = 12, height = 7.5, units = "in", res = 300, bg = "white")
print(p5)
dev.off()

