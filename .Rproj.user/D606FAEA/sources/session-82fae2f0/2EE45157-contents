library(dplyr)
library(tidyr)
library(vegan)

dataA <- read.csv("C:/Users/Hubert/Desktop/Biodiversity Monitoring/Biodiversity data analysis/data input/mothbox/dataA.csv")

#first, I want to treat each night independently, so I need to make a column to designate night

#first I'll standardize local time
tz_local <- "America/Panama"

dataA <- dataA %>%
  mutate(
    # Parse the localTime strings as local clock time in tz_local
    localTime = as.POSIXct(localTime, format = "%Y-%m-%d %H:%M:%S", tz = tz_local),
    
    # Night label: same date for times >= 12:00:00, otherwise previous date
    night = as.Date(localTime, tz = tz_local) - as.integer(hour(localTime) < 12)
    
    # If you prefer a character column: uncomment next line
    # night = format(as.Date(localTime, tz = tz_local) - as.integer(hour(localTime) < 12), "%Y-%m-%d")
  )

### Richness through time, from when the light is first turned on:

#I'll start by making a column for cumulative richness per hour
dataA <- dataA %>%
  # one identifier per hour window
  mutate(session = floor_date(localTime, unit = "hour")) %>%
  group_by(session) %>%
  arrange(localTime, .by_group = TRUE) %>%           # ensure within-hour order
  mutate(cumulativeRichness_hour = cumsum(!duplicated(name) & !is.na(name))) %>%
  ungroup()

#similar, but cumulative richness per night
dataA$cumulativeRichness_night <- with(
  dataA,
  ave(name, night, FUN = function(x) cumsum(!duplicated(x) & !is.na(x)))
)

#Convert 'minute' to numeric for proper plotting
dataA$minute <- as.numeric(dataA$minute)

#Add':00' to each hour value
dataA$hour <- paste(dataA$hour, "00", sep = ":")  

# Ensure 'hour' is treated as a factor
dataA$hour <- factor(dataA$hour)

#Determine max minute to pad the x-axis
max_minute <- max(dataA$minute)

#add a column of just date
dataA$date <- as.Date(dataA$localTime)

### still issues with time zone!!! even if localTime shows the 10th, date shows the 11th. 

#let's do this a different way:
dataA$date <- substr(dataA$localTime, nchar(dataA$localTime) - 9, nchar(dataA$localTime))

######### cumulative activity per hour
dataA <- dataA %>%
  group_by(eventID) %>%
  mutate(detections_per_photo = n()) %>%
  ungroup()


#make sure everything is numeric
dataA$cumulativeRichness_hour <- as.numeric(dataA$cumulativeRichness_hour)
dataA$cumulativeRichness_night <- as.numeric(dataA$cumulativeRichness_night)
dataA$detections_per_photo <- as.numeric(dataA$detections_per_photo)


### adding 0-value rows to represent blank sheets at the start of each session

# 1. Find one template row per session that *doesn't* already have minute == 0
sessions_needing_zero <- dataA %>%
  group_by(session) %>%
  filter(!any(minute == 0)) %>%  # only sessions lacking a minute 0 row
  slice(1) %>%                   # take the first row as a template
  ungroup()

# 2. Create the "zero" rows
zeros <- sessions_needing_zero %>%
  mutate(
    minute                  = 0,
    cumulativeRichness_hour = 0,
    cumulativeRichness_night = 0,
    detections_per_photo    = 0
  )

# 3. Give NA values to each value that was specific to the template rows
cols_to_na <- c(2, 4, 6:14)
zeros[, cols_to_na] <- NA

# 4. Bind back and order so each session starts at minute 0
dataA <- bind_rows(dataA, zeros) %>%
  arrange(session, minute, localTime)


######## Activity and richness across night

#### decision point: do I average each night, or pool them together?
#Better to average I think.

#calculate total number of observations in hours (pooled across all nights, not doing this)
#dataA <- dataA %>%
#  group_by(hour) %>%
#  mutate(cumulative_activity = n()) %>%
#  ungroup()



## ---- Average activity and richness per hour across nights ----

avg_hour_summary <- dataA %>%
  # 1) Work at the level of night × hour
  group_by(night, hour) %>%
  summarise(
    # Number of detections in this night-hour
    n_in_hour = n(),                              
    # Species richness in this night-hour (unique "name" values)
    richness  = n_distinct(name, na.rm = TRUE),   
    .groups = "drop"
  ) %>%
  # 2) Collapse to one row per hour, averaging across nights
  group_by(hour) %>%
  summarise(
    nights_counted = n(),                             # number of nights contributing to this hour
    
    # Mean detections per hour across nights
    avg_activity   = mean(n_in_hour, na.rm = TRUE),
    # Standard error of activity across nights
    se_activity    = sd(n_in_hour,  na.rm = TRUE) / sqrt(nights_counted),
    
    # Mean richness per hour across nights
    avg_richness   = mean(richness,  na.rm = TRUE),
    # Standard error of richness across nights
    se_richness    = sd(richness,   na.rm = TRUE) / sqrt(nights_counted),
    
    .groups = "drop"
  )

## ---- Create summary table for plotting ----

activity_data <- avg_hour_summary %>%
  # Keep only what you need for plotting/summary
  select(hour,
         avg_activity, se_activity,
         avg_richness, se_richness,
         nights_counted) %>%
  distinct()  # one row per hour

## ---- Relabel hours as time windows and control plotting order ----

# These are the labels you want to appear on the x-axis, in order
custom_order <- c("19:00 - 20:00",
                  "21:00 - 22:00",
                  "23:00 - 00:00",
                  "02:00 - 03:00",
                  "04:00 - 05:00")

# Replace the raw hour values with these labels.
# This assumes activity_data has 5 rows and they correspond to these windows.
activity_data$hour <- custom_order

# Make 'hour' an ordered factor so ggplot respects this order on the x-axis
activity_data <- activity_data %>%
  mutate(hour = factor(hour, levels = unique(hour)))



