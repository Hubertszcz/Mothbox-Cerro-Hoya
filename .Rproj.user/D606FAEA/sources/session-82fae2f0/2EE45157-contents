library(dplyr)
library(tidyr)
library(vegan)

dataB <- read.csv("C:/Users/Hubert/Desktop/Biodiversity Monitoring/Biodiversity data analysis/data input/mothbox/dataB.csv")

#calculating frequency
dataC <- dataB %>%
  group_by(point, name) %>%
  summarise(freq = n(), .groups = "drop")

#make point data wide for vegan package
data_wide <- dataC %>% spread(key=name, value=freq)

#replace NA values with 0:
data_wide[is.na(data_wide)] <- 0

#making dataframe of just counts:
data_counts <- data_wide[,-c(1)]

insect_activity <- rowSums(data_counts)           #Total activity (sum of unique observations/photo for all photos)
insect_richness <- specnumber(data_counts)        #morphospecies richness 

land_use <- c("teak", "teak", "reforestation", "mature")

#dataframe for visualizations
mothbox_data <- data_wide[,c(1)]
mothbox_data$land_use <- land_use
mothbox_data$insect_activity <- insect_activity
mothbox_data$insect_richness <- insect_richness

# average by land_use (this will average AZ017 and AZ018 because both are teak), and calculate standard error
mothbox_summary <- mothbox_data %>%
  group_by(land_use) %>%
  summarise(
    mean_insect_activity  = mean(insect_activity, na.rm = TRUE),
    se_insect_activity    = sd(insect_activity, na.rm = TRUE) / sqrt(n()),
    mean_insect_richness  = mean(insect_richness, na.rm = TRUE),
    se_insect_richness    = sd(insect_richness, na.rm = TRUE) / sqrt(n()),
    .groups = "drop"
  )


