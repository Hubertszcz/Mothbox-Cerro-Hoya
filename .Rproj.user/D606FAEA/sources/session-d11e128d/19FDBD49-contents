#Download the list, DO NOT OPEN IT! 

# This looks like a csv that is openable in excel. Wrong! it is actually tab delimited txt file that's pretending to be a csv
# If you tried to open it it would look like all information is in one column, and it would reformat it to be unreadable by mothbot scripts
# So, important to open the file in R as shown here, and exporting as shown here.


#The list as you have it now is still pretty messy, it includes synonyms and unaccepted names, so here is how to open it and clean it:


#load data

Species_list <- read.delim("C:/Users/Hubert/Downloads/lima_species_list.csv",
                           header = TRUE,
                           sep = "\t",
                           quote = "\"",
                           stringsAsFactors = FALSE,
                           encoding = "UTF-8")

## ---------- Helpers ----------
to_utf8 <- function(x) {
  if (is.factor(x)) x <- as.character(x)
  if (is.character(x)) x <- iconv(x, from = "", to = "UTF-8", sub = "")
  x
}
getcol <- function(df, nm) if (nm %in% names(df)) df[[nm]] else rep(NA, nrow(df))
nchar_bytes <- function(x) nchar(ifelse(is.na(x), "", x), type = "bytes", allowNA = TRUE)
strip_authorship <- function(x) {
  x <- to_utf8(x)
  x <- gsub("\\s+", " ", trimws(x))
  x <- sub("^([A-Z][a-zA-Z.-]+\\s+[a-z][a-zA-Z.-]+).*", "\\1", x, perl = TRUE)
  x <- sub("^×\\s*", "", x)
  x
}
first_non_na <- function(x) x[which(!is.na(x) & nzchar(as.character(x)))[1]]

# Normalize text columns to UTF-8
for (nm in names(Species_list)) Species_list[[nm]] <- to_utf8(Species_list[[nm]])

# Store original column order
col_order <- names(Species_list)

## ---------- Prep ----------
Species_list$taxonRank           <- toupper(as.character(getcol(Species_list, "taxonRank")))
Species_list$taxonomicStatus     <- toupper(as.character(getcol(Species_list, "taxonomicStatus")))
Species_list$numberOfOccurrences <- suppressWarnings(as.numeric(getcol(Species_list, "numberOfOccurrences")))

## ---------- 1) Species-level, ACCEPTED only ----------
sp_ok <- !is.na(getcol(Species_list, "speciesKey")) &
  Species_list$taxonRank == "SPECIES" &
  Species_list$taxonomicStatus == "ACCEPTED"
species_df <- Species_list[sp_ok, , drop = FALSE]

pri_name <- ifelse(!is.na(getcol(species_df, "acceptedScientificName")) &
                     nzchar(getcol(species_df, "acceptedScientificName")),
                   getcol(species_df, "acceptedScientificName"),
                   getcol(species_df, "scientificName"))
pri_name <- to_utf8(pri_name)

ord_sp <- order(
  -ifelse(is.na(species_df$numberOfOccurrences), 0, species_df$numberOfOccurrences),
  -nchar_bytes(pri_name),
  na.last = TRUE
)
species_df <- species_df[ord_sp, , drop = FALSE]
species_df <- species_df[!duplicated(getcol(species_df, "speciesKey")), , drop = FALSE]

## ---------- 2) Genus-only rows ----------
gn_ok <- !is.na(getcol(Species_list, "genusKey")) &
  Species_list$taxonRank == "GENUS" &
  Species_list$taxonomicStatus == "ACCEPTED"
genus_df <- Species_list[gn_ok, , drop = FALSE]

g_with_species <- unique(getcol(species_df, "genusKey"))
genus_df <- genus_df[!(getcol(genus_df, "genusKey") %in% g_with_species), , drop = FALSE]

genus_name <- to_utf8(getcol(genus_df, "genus"))
ord_g <- order(
  -ifelse(is.na(genus_df$numberOfOccurrences), 0, genus_df$numberOfOccurrences),
  -nchar_bytes(genus_name),
  na.last = TRUE
)
genus_df <- genus_df[ord_g, , drop = FALSE]
genus_df <- genus_df[!duplicated(getcol(genus_df, "genusKey")), , drop = FALSE]

## ---------- 3) Family rows ----------
families <- unique(na.omit(c(species_df$familyKey, genus_df$familyKey)))
family_out <- data.frame(matrix(ncol = length(col_order), nrow = 0))
names(family_out) <- col_order

for (fk in families) {
  subdf <- rbind(
    species_df[species_df$familyKey == fk, , drop = FALSE],
    genus_df[genus_df$familyKey == fk, , drop = FALSE]
  )
  if (nrow(subdf) == 0) next
  row <- as.list(rep(NA, length(col_order)))
  names(row) <- col_order
  row$taxonKey <- fk
  row$taxonRank <- "FAMILY"
  row$taxonomicStatus <- "ACCEPTED"
  row$family <- first_non_na(subdf$family)
  row$familyKey <- fk
  row$order <- first_non_na(subdf$order)
  row$orderKey <- first_non_na(subdf$orderKey)
  row$class <- first_non_na(subdf$class)
  row$classKey <- first_non_na(subdf$classKey)
  row$phylum <- first_non_na(subdf$phylum)
  row$phylumKey <- first_non_na(subdf$phylumKey)
  row$kingdom <- first_non_na(subdf$kingdom)
  row$kingdomKey <- first_non_na(subdf$kingdomKey)
  family_out <- rbind(family_out, row, stringsAsFactors = FALSE)
}

## ---------- 4) Order rows ----------
orders <- unique(na.omit(c(species_df$orderKey, genus_df$orderKey)))
order_out <- data.frame(matrix(ncol = length(col_order), nrow = 0))
names(order_out) <- col_order

for (ok in orders) {
  subdf <- rbind(
    species_df[species_df$orderKey == ok, , drop = FALSE],
    genus_df[genus_df$orderKey == ok, , drop = FALSE]
  )
  if (nrow(subdf) == 0) next
  row <- as.list(rep(NA, length(col_order)))
  names(row) <- col_order
  row$taxonKey <- ok
  row$taxonRank <- "ORDER"
  row$taxonomicStatus <- "ACCEPTED"
  row$order <- first_non_na(subdf$order)
  row$orderKey <- ok
  row$class <- first_non_na(subdf$class)
  row$classKey <- first_non_na(subdf$classKey)
  row$phylum <- first_non_na(subdf$phylum)
  row$phylumKey <- first_non_na(subdf$phylumKey)
  row$kingdom <- first_non_na(subdf$kingdom)
  row$kingdomKey <- first_non_na(subdf$kingdomKey)
  order_out <- rbind(order_out, row, stringsAsFactors = FALSE)
}

## ---------- 5) Class row (Insecta) ----------
class_out <- data.frame(matrix(ncol = length(col_order), nrow = 0))
names(class_out) <- col_order
if ("Insecta" %in% unique(c(species_df$class, genus_df$class))) {
  subdf <- rbind(species_df, genus_df)
  row <- as.list(rep(NA, length(col_order)))
  names(row) <- col_order
  row$taxonKey <- first_non_na(subdf$classKey)
  row$taxonRank <- "CLASS"
  row$taxonomicStatus <- "ACCEPTED"
  row$class <- "Insecta"
  row$classKey <- first_non_na(subdf$classKey)
  row$phylum <- first_non_na(subdf$phylum)
  row$phylumKey <- first_non_na(subdf$phylumKey)
  row$kingdom <- first_non_na(subdf$kingdom)
  row$kingdomKey <- first_non_na(subdf$kingdomKey)
  class_out <- rbind(class_out, row, stringsAsFactors = FALSE)
}

## ---------- 6) Combine ----------
final_out <- rbind(species_df, genus_df, family_out, order_out, class_out)

# Remove duplicates by (taxonRank + taxonKey)
final_out <- final_out[!duplicated(paste(final_out$taxonRank, final_out$taxonKey, sep="|")), , drop = FALSE]

# Keep only original columns, same order
final_out <- final_out[, col_order, drop = FALSE]


## ---------- 8) Export ----------
#make sure to change the export name to this format:

#SpeciesList_CountryPanamaCostaRica_TaxaInsecta_doi.org10.15468dl.6nxkw6

###Change the Country (this list has both Panama and Costa Rica), and change the doi


#Write it back out in the same style as you got it from GBIF (tab-separated, UTF-8, quoted)
write.table(final_out,
            file = "C:/Users/Hubert/Downloads/species lists/Donald's species list2.csv", #extension .txt to be sure it's different and keep it safer from excel reformatting
            sep = "\t",
            row.names = FALSE,
            col.names = TRUE,
            quote = TRUE,
            fileEncoding = "UTF-8",
            na = "")  # GBIF uses empty string for missing values


